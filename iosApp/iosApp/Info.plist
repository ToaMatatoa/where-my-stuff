<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!--
	  The languages the bundle claims to support. iOS picks the app language by intersecting this
	  list with the user's preferred languages; without an entry here it reports English no matter
	  what the device is set to, and the Compose values-ru resources would never be selected.
	  Keep this in sync with the values-<lang> folders in composeApp/composeResources.
	-->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ru</string>
	</array>
	<!-- Deliberately not localized: the app name stays English on every device. -->
	<key>CFBundleDisplayName</key>
	<string>Where My Stuff</string>
	<!--
	  Launch screen: the wordmark centred on the icon's background colour, matching the Android
	  splash. LaunchBackground declares an explicit dark appearance with the same value, so iOS
	  dark mode cannot shift it.
	-->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchIcon</string>
	</dict>
</dict>
</plist>